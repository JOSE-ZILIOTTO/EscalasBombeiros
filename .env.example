# Modelo de configuração. Copie para ".env" e preencha os valores reais.
# O arquivo .env NUNCA deve ir para o git (já está no .gitignore).
# Valores com caracteres especiais (! ; = espaço) devem ficar entre aspas.

# Banco de dados
DB_SERVER=localhost
DB_USERNAME=
DB_PASSWORD=""
DB_NAME=escala_db

# Fuso horário usado para "mês atual" e datas padrão
APP_TIMEZONE=America/Sao_Paulo

# Regras de negócio (opcionais; os valores abaixo são o padrão)
VAGAS_BC_POR_TURNO=1
REMUNERACAO_TURNO_12H=125
REMUNERACAO_TURNO_24H=250

# Proteção do login contra força bruta
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=900

# Proteção de dados pessoais (LGPD)
# Chave que criptografa CPF e dados bancários no banco (32 bytes em base64). OBRIGATÓRIA.
# Gere uma por instalação:  php -r "echo base64_encode(random_bytes(32));"
# Guarde uma cópia em local seguro: sem ela, CPF e dados bancários gravados não podem ser lidos.
CHAVE_DADOS=
# Anos que os dados de quem foi inativado continuam guardados antes de serem apagados
RETENCAO_DADOS_INATIVOS_ANOS=5
# 1 em produção: redireciona http:// para https:// e ativa HSTS (só com certificado SSL funcionando)
FORCAR_HTTPS=0
# Aviso de privacidade (privacidade.php): quem trata os dados e onde o titular faz pedidos
PRIVACIDADE_CONTROLADOR=
PRIVACIDADE_CONTATO=
