{
    "name": "jose-ziliotto/escalas-bombeiros",
    "description": "Sistema de escala de plantões de bombeiros (BC e Fixo)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Escala\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Escala\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build-producao": "@composer install --no-dev --optimize-autoloader --classmap-authoritative"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    }
}
